flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([CLI user]):::edge
    Client([HTTP client]):::edge

    subgraph Interfaces["Interfaces (CLI and stdlib HTTP)"]
        direction TB
        CLI["cli.py<br/>evaluate | audit | serve"]:::edge
        Router["service.py router<br/>/health /ready /audit /metrics"]:::core
        Validate["Request validation<br/>text, max 4000 characters"]:::control
    end

    subgraph Core["Audit pipeline (deterministic)"]
        direction TB
        Text["text.py<br/>normalize, split sentences"]:::core
        Extract["extraction.py<br/>rule-based subject, relation, object"]:::core
        Verify["verification.py<br/>supported | refuted | unverifiable"]:::core
        Score["scoring.py<br/>document judgment and confidence"]:::core
    end

    subgraph State["Data and state (in memory)"]
        direction TB
        KB[("Knowledge base<br/>functional facts")]:::data
        Labeled[("Labeled answers<br/>factual or hallucinated")]:::data
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Detection["Detection metrics<br/>vs trust-everything baseline"]:::obs
        Calibration["calibration.py<br/>reliability bins, ECE"]:::obs
        Response["Audit JSON<br/>per-claim verdicts and evidence"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus text"]:::obs
    end

    User -->|arguments| CLI
    Client -->|JSON request| Router
    Router -->|POST /audit| Validate
    Validate -->|answer text| Text
    CLI -->|answer text| Text
    Text -->|sentences| Extract
    Extract -->|claims| Verify
    KB -.->|canonical fact lookup| Verify
    Verify -->|claim verdicts| Score
    Score -->|judgment| Response
    Labeled -.->|gold labels| Detection
    Score -->|flagged or not| Detection
    Score -->|confidence vs correctness| Calibration
    Router -.->|route latency and errors| Metrics
