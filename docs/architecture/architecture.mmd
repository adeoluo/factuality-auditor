flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>evaluate, audit, serve"]:::edge
        Router["HTTP service<br/>/audit /metrics"]:::core
        Validate["Validation<br/>text, max 4000 chars"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        KB[("Knowledge base<br/>functional facts")]:::data
        Labeled[("Labeled answers<br/>factual, hallucinated")]:::data
        KB ~~~ Labeled
    end

    subgraph Core["Audit pipeline"]
        direction TB
        Text["Sentence splitting<br/>and normalization"]:::core
        Extract["Claim extraction<br/>subject-relation-object"]:::core
        Verify["Verification<br/>supported or refuted"]:::core
        Score["Document scoring<br/>judgment, confidence"]:::core
        Text --> Extract --> Verify --> Score
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Response["Audit JSON<br/>verdicts and evidence"]:::obs
        Detection["Detection metrics<br/>vs trust-all baseline"]:::obs
        Calibration["Calibration<br/>reliability bins, ECE"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Response ~~~ Detection ~~~ Calibration ~~~ Metrics
    end

    Interfaces -->|answer text| Core
    State -.->|canonical facts| Core
    Core -->|judgment| Obs
    State -.->|gold labels| Obs
